# Hub (dashboard) and API
SITE_URL=https://localhost
NEXT_PUBLIC_SITE_URL=https://localhost
# Public base of the device API (Caddy strips /api before the API service).
# Devices sign DPoP proofs for this URL: never change it on an existing install.
API_URL=https://localhost/api
# Signs device access tokens; changing it logs every device out. Generated by manage.sh setup.
JWT_SECRET=
BETTER_AUTH_SECRET=fleetctrl_secret_123456
ALLOW_REGISTRATION=true
NEXT_PUBLIC_ALLOW_REGISTRATION=true

# Proxy Configuration
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
CADDY_DOMAIN=localhost
# Set to 'true' for self-signed certs (internal/dev), 'false' for Let's Encrypt (public domain)
TLS_INTERNAL=true
# Set to 'true' if running behind external reverse proxy (e.g., Nginx Proxy Manager, Traefik)
# When true, Caddy will only listen on HTTP and won't handle TLS
BEHIND_PROXY=false

# Postgres Configuration
# The API uses the `fleetctrl` database. Installs upgraded from v2 keep POSTGRES_USER=convex and
# POSTGRES_DB=convex_self_hosted, because the existing data volume was created with them.
POSTGRES_USER=fleetctrl
POSTGRES_DB=fleetctrl
POSTGRES_PASSWORD=changeme
POSTGRES_DATA_DIR=postgres_data
# Optional: use an external Postgres instead
# DATABASE_URL=postgresql://user:password@host:5432/fleetctrl

# RustFS (S3-compatible storage for installers, scripts and client updates)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_SERVER_DOMAINS=localhost,rustfs
RUSTFS_DATA_DIR=rustfs-data
RUSTFS_CONSOLE_ENABLE=true
S3_BUCKET=fleetctrl-files
