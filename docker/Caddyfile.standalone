{
    # Caddy will automatically get Let's Encrypt certificates for public domains
    # For internal/dev environments, it will fall back to self-signed certs
}

{$CADDY_DOMAIN} {
    # Use self-signed certs for internal/dev environments
    # Comment out this line for production with valid public DNS
    tls internal

    # Better Auth for the dashboard (API service). No prefix is stripped.
    handle /auth* {
        reverse_proxy api:3001
    }

    # Device API and admin API (API service). `/api` is stripped: devices sign DPoP proofs for
    # API_URL + path, so this layout must not change. Event streams are flushed immediately.
    handle /api* {
        uri strip_prefix /api
        reverse_proxy api:3001
    }

    # Dashboard (Next.js)
    reverse_proxy hub:3000
}
