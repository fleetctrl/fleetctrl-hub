# FleetCtrl API: device API, Better Auth and the dashboard's admin API (Hono on Node).
# The bundle (tsup) is self-contained, so the runtime image has no node_modules.
# The same image runs the one-shot `db-migrate` service and the Convex importer.
FROM node:22-alpine AS build
RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN npm install -g pnpm@10.25.0
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build:api

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV MIGRATIONS_DIR=/app/drizzle

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 api

COPY --from=build --chown=api:nodejs /app/dist/api ./
COPY --from=build --chown=api:nodejs /app/drizzle ./drizzle

USER api
EXPOSE 3001

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3001/health >/dev/null || exit 1

CMD ["node", "--enable-source-maps", "index.js"]
