# Local development. Copy to .env.local: the API (pnpm dev:api), the migrator (pnpm db:migrate),
# the importer and Next.js all read it. Docker deployments use docker/.env.example instead.

# ─────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────
# Postgres and RustFS from docker/docker-compose.dev.yml
DATABASE_URL=postgres://fleetctrl:fleetctrl@localhost:5433/fleetctrl
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=fleetctrl-files
S3_REGION=us-east-1

# Signs device access tokens, at least 32 characters. Generate with `openssl rand -hex 32`.
JWT_SECRET=
# Generate with `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
ALLOW_REGISTRATION=true

SITE_URL=http://localhost:3000
# Public base of the device API. Devices sign DPoP proofs for this URL + path. In development
# Next.js forwards /api/* to the API, so devices can use http://localhost:3000/api as their server URL.
API_URL=http://localhost:3000/api
PORT=3001

# ─────────────────────────────────────────────────────────
# Next.js
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ALLOW_REGISTRATION=true
# Where Next.js forwards /api/* and /auth/*. Defaults to http://localhost:3001 in development.
# API_PROXY_TARGET=http://localhost:3001
